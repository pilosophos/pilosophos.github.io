---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Gallery, prepareArtForGallery } from '@components/galleryviewer/Gallery.jsx';
import ArticleHeader from '@components/ArticleHeader.astro';

const art = (
  await getCollection('art'))
    .filter(piece => piece.data.tags?.includes('sketchbook') && !piece.data.tags?.includes('notmine'))
    .toSorted((a, b) => b.data.date?.getTime() - a.data.date?.getTime()
);

const galleryItems = await prepareArtForGallery(art)
---
<DefaultLayout
  title="Sketchbook"
  metadesc="Sketches and scraps by the artist Pilosophos."
>
  <main class="container">
    <ArticleHeader
      title="Sketchbook"
    >
      Some of my unfinished sketches, scraps, and works-in-progress
    </ArticleHeader>

    <Gallery
      client:load
      pieces={ galleryItems }
    />
  </main>
</DefaultLayout>